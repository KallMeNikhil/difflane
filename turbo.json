{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@difflane/shared-types#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@difflane/shared-types#lint": {
      "dependsOn": ["^build", "build"]
    }
  }
}
