PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:7777

DATABASE_URL=postgresql://user:password@localhost:5432/difflane

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=10
OAUTH_STATE_TTL_MINUTES=10

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:7777/auth/callback/google

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:7777/auth/callback/github

GITHUB_API_TOKEN=

RATE_LIMIT_STRICT_WINDOW_MS=900000
RATE_LIMIT_STRICT_MAX=10
RATE_LIMIT_MODERATE_WINDOW_MS=900000
RATE_LIMIT_MODERATE_MAX=60
RATE_LIMIT_RELAXED_WINDOW_MS=900000
RATE_LIMIT_RELAXED_MAX=300
SOCKET_RATE_LIMIT_WINDOW_MS=10000
SOCKET_RATE_LIMIT_ROOM_JOIN_MAX=10
SOCKET_RATE_LIMIT_DOC_UPDATE_MAX=120
SOCKET_RATE_LIMIT_AWARENESS_UPDATE_MAX=240
SOCKET_RATE_LIMIT_ATTENTION_REQUEST_MAX=6
SOCKET_RATE_LIMIT_TERMINAL_CREATE_MAX=6
SOCKET_RATE_LIMIT_TERMINAL_INPUT_MAX=400

JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_REQUEST_TIMEOUT_MS=15000
JUDGE0_POLL_INTERVAL_MS=700
JUDGE0_POLL_TIMEOUT_MS=20000
EXECUTION_MAX_CONCURRENT_PER_USER=2
EXECUTION_MAX_CONCURRENT_PER_WORKSPACE=4
TERMINAL_SHELL_PATH=/bin/bash
TERMINAL_SANDBOX_ROOT=/tmp/difflane-terminal-sessions
